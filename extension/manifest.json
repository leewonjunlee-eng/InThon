{
  "manifest_version": 3,
  "name": "CatchSound",
  "version": "0.2.1",
  "description": "CatchSound로 여러 탭의 소리를 자유롭게 조절해보세요. 중요한 순간은 놓치지 않으면서, 지금 하는 일에 온전히 집중할 수 있습니다.",
  "minimum_chrome_version": "139",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "CatchSound",
    "default_popup": "popup/index.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "connect-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "현재 탭 소리 연결"
    },
    "switch-focus": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "MacCtrl+Shift+Right"
      },
      "description": "다른 소리에 집중"
    },
    "restore": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left",
        "mac": "MacCtrl+Shift+Left"
      },
      "description": "이전 상태로 복귀"
    }
  }
}
